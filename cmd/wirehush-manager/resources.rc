#include <windows.h>
#define STRINGIZE(x) #x
#define EXPAND(x) STRINGIZE(x)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 RT_MANIFEST "manifest.xml"
7 ICON "WireHush.ico"
wireguard.dll RCDATA "wireguard.dll"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION WIREHUSH_VERSION_ARRAY
 PRODUCTVERSION WIREHUSH_VERSION_ARRAY
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "WireHush contributors"
   VALUE "FileDescription", "WireHush privileged manager"
   VALUE "FileVersion", EXPAND(WIREHUSH_VERSION)
   VALUE "OriginalFilename", "WireHush-Manager.exe"
   VALUE "ProductName", "WireHush"
   VALUE "ProductVersion", EXPAND(WIREHUSH_VERSION)
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 0x4b0
 END
END
