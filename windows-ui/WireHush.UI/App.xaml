<Application
    x:Class="WireHush.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="WireHushHeaderColor">#131B22</Color>
            <Color x:Key="WireHushRailColor">#0C1218</Color>
            <Color x:Key="WireHushCanvasColor">#0F171E</Color>
            <Color x:Key="WireHushCardColor">#10181E</Color>
            <Color x:Key="WireHushBorderColor">#243642</Color>
            <Color x:Key="WireHushSelectedColor">#09334B</Color>
            <Color x:Key="WireHushCyanColor">#04C1F3</Color>
            <Color x:Key="WireHushGreenColor">#17DB55</Color>
            <Color x:Key="WireHushTextColor">#F3F7FA</Color>
            <Color x:Key="WireHushMutedColor">#8FA8B9</Color>

            <SolidColorBrush x:Key="WireHushHeaderBrush" Color="{StaticResource WireHushHeaderColor}" />
            <SolidColorBrush x:Key="WireHushRailBrush" Color="{StaticResource WireHushRailColor}" />
            <SolidColorBrush x:Key="WireHushCanvasBrush" Color="{StaticResource WireHushCanvasColor}" />
            <SolidColorBrush x:Key="WireHushCardBrush" Color="{StaticResource WireHushCardColor}" />
            <SolidColorBrush x:Key="WireHushBorderBrush" Color="{StaticResource WireHushBorderColor}" />
            <SolidColorBrush x:Key="WireHushSelectedBrush" Color="{StaticResource WireHushSelectedColor}" />
            <SolidColorBrush x:Key="WireHushCyanBrush" Color="{StaticResource WireHushCyanColor}" />
            <SolidColorBrush x:Key="WireHushGreenBrush" Color="{StaticResource WireHushGreenColor}" />
            <SolidColorBrush x:Key="WireHushTextBrush" Color="{StaticResource WireHushTextColor}" />
            <SolidColorBrush x:Key="WireHushMutedBrush" Color="{StaticResource WireHushMutedColor}" />

            <Style x:Key="WireHushHeaderCommandStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource WireHushTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="WireHushPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#0866B8" />
                <Setter Property="BorderBrush" Value="#0B91E8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="WireHushSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource WireHushTextBrush}" />
                <Setter Property="Background" Value="#111D26" />
                <Setter Property="BorderBrush" Value="#385067" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="WireHushCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WireHushCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WireHushBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
